# ── Secrets (never commit) ──────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Build output ────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Next.js ─────────────────────────────────────────────────────
frontend/.next/
frontend/out/

# ── Logs & debug ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Test / coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker local data (if you bind-mount volumes locally) ─────
docker-data/
mysql-data/
redis-data/

# ── OS & editor junk ────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
!.vscode/extensions.json

# ── Misc caches ─────────────────────────────────────────────────
.cache/
.eslintcache
.turbo/
